{
  "name": "quotes-server",
  "version": "1.0.0",
  "description": "REST API for a quotes app built with Express, Sequelize, PostgreSQL, and Docker.",
  "author": "Serhii Lisovyk",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#config": "./src/config/index.js",
    "#constants": "./src/constants/index.js",
    "#controllers/*": "./src/controllers/*/index.js",
    "#database": "./src/database/db.js",
    "#errors/*": "./src/errors/*/index.js",
    "#logger": "./src/logger/logger.service.js",
    "#middlewares/*": "./src/middlewares/*/index.js",
    "#models": "./src/database/models/index.js",
    "#models/hooks": "./src/database/models/hooks/index.js",
    "#routes/*": "./src/routes/*/index.js",
    "#services/*": "./src/services/*/index.js",
    "#tests/*": "./src/tests/*/index.js",
    "#utils/*": "./src/utils/*/index.js",
    "#validators/*": "./src/validators/*/index.js"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.js",
    "start": "node --env-file-if-exists=.env src/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
